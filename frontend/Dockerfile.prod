# Production Dockerfile for OpenThreat Frontend

# Stage 1: Build
FROM node:25-alpine AS builder

WORKDIR /app

# API base URL baked into the client bundle. Empty = same origin: the
# browser calls /api/... on whatever host/port served the page and nginx
# routes it to the backend. Only set this if the API lives elsewhere.
ARG NEXT_PUBLIC_API_URL=
ENV NEXT_PUBLIC_API_URL=$NEXT_PUBLIC_API_URL
ENV NEXT_TELEMETRY_DISABLED=1

# Copy package files
COPY package*.json ./

# Install ALL dependencies (needed for build)
RUN npm ci

# Copy source code
COPY . .

# Build application (next.config.js sets output: 'standalone')
RUN npm run build

# Stage 2: Production - only the standalone server and static assets
FROM node:25-alpine

WORKDIR /app

ENV NODE_ENV=production \
    NEXT_TELEMETRY_DISABLED=1 \
    HOSTNAME=0.0.0.0 \
    PORT=3000

# Create non-root user
RUN addgroup -g 1001 openthreat && \
    adduser -D -u 1001 -G openthreat openthreat

COPY --from=builder --chown=openthreat:openthreat /app/.next/standalone ./
COPY --from=builder --chown=openthreat:openthreat /app/.next/static ./.next/static

USER openthreat

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=40s --retries=3 \
    CMD node -e "require('http').get('http://127.0.0.1:3000', (r) => {process.exit(r.statusCode === 200 ? 0 : 1)}).on('error', () => process.exit(1))"

# Expose port
EXPOSE 3000

# Start application
CMD ["node", "server.js"]
