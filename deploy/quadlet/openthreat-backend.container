[Unit]
Description=OpenThreat API (FastAPI)
PartOf=openthreat.target
# ordered after the target: "systemctl stop openthreat.target" waits until this is down
After=openthreat.target
Requires=openthreat-postgres.service openthreat-redis.service
After=openthreat-postgres.service openthreat-redis.service

[Container]
ContainerName=openthreat-backend
# Tagged by deploy/deploy.sh: :current = deployed commit, :previous = rollback
Image=localhost/openthreat-backend:current
Network=openthreat.network
IP=@SUBNET@.20
PodmanArgs=--network-alias=backend --memory=1g --cpus=1
EnvironmentFile=@STATE@/app.env
# Health check defined here, not taken from the image: CI publishes OCI
# images (provenance/SBOM), and Podman ignores the Dockerfile HEALTHCHECK
# in OCI images. Hung -> killed -> restarted by systemd.
HealthCmd=python -c "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8001/health', timeout=5)"
HealthInterval=30s
HealthTimeout=10s
HealthRetries=3
HealthStartPeriod=60s
HealthOnFailure=kill
Notify=healthy

[Service]
Restart=always
RestartSec=5
TimeoutStartSec=300

[Install]
WantedBy=openthreat.target
