[Unit]
Description=OpenThreat nginx (TLS, caching, rate limits)
PartOf=openthreat.target
# ordered after the target: "systemctl stop openthreat.target" waits until this is down
After=openthreat.target
Wants=openthreat-backend.service openthreat-frontend.service
After=openthreat-backend.service openthreat-frontend.service

[Container]
ContainerName=openthreat-nginx
Image=docker.io/library/nginx:alpine
AutoUpdate=registry
Network=openthreat.network
IP=@SUBNET@.30
PublishPort=@HTTP_PORT@:80
PublishPort=@HTTPS_PORT@:443
# nginx.conf is a template: only NGINX_PUBLIC_* is substituted at start
Environment=NGINX_ENVSUBST_OUTPUT_DIR=/etc/nginx NGINX_ENVSUBST_FILTER=^NGINX_PUBLIC_ NGINX_PUBLIC_HTTPS_PORT=@HTTPS_PORT@
Volume=@REPO@/nginx/nginx.conf:/etc/nginx/templates/nginx.conf.template:ro,Z
Volume=@REPO@/nginx/ssl:/etc/nginx/ssl:ro,Z
Volume=openthreat-nginx-cache.volume:/var/cache/nginx

[Service]
Restart=always
RestartSec=5

[Install]
WantedBy=openthreat.target
