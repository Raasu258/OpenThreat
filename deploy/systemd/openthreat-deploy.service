# One pull-and-deploy run (deploy/deploy.sh). Started by the timer, or now:
#   systemctl --user start openthreat-deploy.service
[Unit]
Description=OpenThreat pull-based deploy
After=openthreat.target

[Service]
Type=oneshot
WorkingDirectory=@REPO@
ExecStart=@REPO@/deploy/deploy.sh
TimeoutStartSec=30min
# 75: another deploy was already running - not an error
SuccessExitStatus=75
Nice=10
