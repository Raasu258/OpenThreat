# OpenThreat stack as a systemd *user* service (rootless Podman).
# Installed by deploy/install.sh; @REPO_DIR@ is replaced there.
[Unit]
Description=OpenThreat stack (podman-compose)

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=@REPO_DIR@
Environment=COMPOSE_PROJECT_NAME=openthreat
ExecStart=podman-compose up -d
ExecStop=podman-compose down
TimeoutStartSec=600
TimeoutStopSec=180

[Install]
WantedBy=default.target
