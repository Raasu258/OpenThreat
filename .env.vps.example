# OpenThreat on the VPS - copy to .env and fill in.  chmod 600 .env
# Generate secrets with:  openssl rand -hex 32

# --- Images (managed by deploy/deploy.sh) ---------------------------------
OT_REGISTRY=ghcr.io/raasu258
# Pinned to the deployed commit by deploy/deploy.sh. "deploy" = latest build.
OT_IMAGE_TAG=deploy

# --- Public ports (rootless Podman, so >= 1024 unless you lower
#     net.ipv4.ip_unprivileged_port_start) --------------------------------
NGINX_HTTP_PORT=8082
NGINX_HTTPS_PORT=8443

# --- Database -----------------------------------------------------------
POSTGRES_DB=openthreat
POSTGRES_USER=openthreat
# URL-safe (it is embedded in DATABASE_URL): openssl rand -hex 24
POSTGRES_PASSWORD=

# --- Application --------------------------------------------------------
ENVIRONMENT=production
LOG_LEVEL=INFO
# >= 32 chars, otherwise the backend refuses to start in production
SECRET_KEY=
CSRF_SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=60
# The frontend calls the API on the same origin, so no CORS origins are
# needed. Only list origins here if another site must call the API.
ALLOWED_ORIGINS=

# Free key, raises the NVD rate limit: https://nvd.nist.gov/developers/request-an-api-key
NVD_API_KEY=

# --- Optional: LLM features ----------------------------------------------
OLLAMA_HOST=
LLM_MODEL=

# --- Optional: email ----------------------------------------------------
SMTP_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=OpenThreat

# --- deploy/deploy.sh ---------------------------------------------------
# Where DB dumps go and how many to keep
DEPLOY_BACKUP_DIR=
DEPLOY_BACKUP_KEEP=14
# Optional push notification on failed/successful deploys, e.g. an ntfy
# topic URL (https://ntfy.sh/<random-topic>) - leave empty to disable
DEPLOY_NOTIFY_URL=
